# Optional local overrides; docker compose up -d works without this file.
COMPOSE_PROJECT_NAME=twenty-autonomus-ccompany
TAG=v2.45.6
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
SERVER_URL=http://localhost:3000
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=postgres
PG_DATABASE_NAME=default
# For production generate a private key with: openssl rand -base64 32
ENCRYPTION_KEY=bG9jYWwtdHdlbnR5LW9ubHktZG8tbm90LXVzZS1wcm8=
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true
DEFAULT_SUBDOMAIN=app
IS_MULTIWORKSPACE_ENABLED=true
# Prefills Twenty's built-in tim@apple.dev credentials, not the bootstrap account.
SIGN_IN_PREFILLED=false
# Optional one-shot bootstrap profile. Set private values in .env.
BOOTSTRAP_ADMIN_EMAIL=admin@lvh.me
BOOTSTRAP_ADMIN_LAST_NAME=User
BOOTSTRAP_ADMIN_PASSWORD=TwentyLocalOnly123!
BOOTSTRAP_WORKSPACE_NAME=Autonomous Company
BOOTSTRAP_WORKSPACE_SUBDOMAIN=autonomous-company
# Generated by the local bootstrap; keep the value private in .env.
TWENTY_API_KEY=
